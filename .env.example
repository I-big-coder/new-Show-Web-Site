# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# MONGODB_URI: MongoDB connection string for Mongoose database persistence.
# Falls back to seeded local persistent datastore when not configured in sandbox preview.
MONGODB_URI="mongodb://localhost:27017/stepzone"

# JWT_SECRET: Secret key used to sign and verify JWT authentication tokens.
JWT_SECRET="stepzone_jwt_secret_key_change_in_production"

# CLOUDINARY Configuration for product & category image storage
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# RAZORPAY Configuration for Indian payment gateway (Order creation & HMAC verification)
RAZORPAY_KEY_ID="rzp_test_stepzone_key_id"
RAZORPAY_KEY_SECRET="rzp_test_stepzone_key_secret"
